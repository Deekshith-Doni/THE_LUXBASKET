# Environment Variables for The LuxBasket

# ============================================================
# DATABASE
# ============================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/luxbasket?retryWrites=true&w=majority

# ============================================================
# AUTHENTICATION (NextAuth.js v5)
# ============================================================
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars
NEXTAUTH_URL=https://www.theluxbasket.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================
# CLOUDINARY (Image Uploads)
# ============================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ============================================================
# EMAIL (Nodemailer)
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@theluxbasket.com

# ============================================================
# WHATSAPP
# ============================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX

# ============================================================
# APP CONFIG
# ============================================================
NEXT_PUBLIC_APP_URL=https://www.theluxbasket.com
NEXT_PUBLIC_APP_NAME=The LuxBasket
NEXT_PUBLIC_APP_DESCRIPTION=Premium Luxury Gifting
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-6VRQNFPYC1
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-public-razorpay-key-id
RAZORPAY_KEY_SECRET=your-server-only-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-server-only-razorpay-webhook-secret

# ============================================================
# ADMIN
# ============================================================
ADMIN_EMAIL=info@theluxbasketgift.com,theluxbasketgifting@gmail.com
JWT_SECRET=your-jwt-secret-key

# Development-only database seeding. The seed API is disabled in production.
SEED_SECRET=replace-with-a-long-random-local-only-value
SEED_ADMIN_EMAIL=seed-admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
